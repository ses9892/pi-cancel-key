{
  "name": "pi-cancel-key",
  "version": "0.1.0",
  "description": "Pick the key that cancels a running pi agent, and automatically remap the keys it displaces.",
  "type": "module",
  "license": "MIT",
  "author": "Jinho Jang <ses1238@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ses9892/pi-cancel-key.git"
  },
  "homepage": "https://github.com/ses9892/pi-cancel-key#readme",
  "bugs": {
    "url": "https://github.com/ses9892/pi-cancel-key/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "keybindings",
    "terminal-ui",
    "tui"
  ],
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cancel-key.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
